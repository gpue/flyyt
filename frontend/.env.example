# Number of fly instances scattered across the ground.
VITE_FLY_COUNT=12

# Random-distribution volume in millimeters, centered on the origin in X/Z.
# Height is upward jitter above the ground plane (0 = all flies flat on the ground).
VITE_FLY_AREA_WIDTH_MM=120
VITE_FLY_AREA_DEPTH_MM=120
VITE_FLY_AREA_HEIGHT_MM=0

# Copy this file to .env (gitignored) to override locally.
